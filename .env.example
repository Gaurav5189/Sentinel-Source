# 1. OpenRouter Intelligence (REQUIRED)
# OPENROUTER_API_KEY=your_openrouter_api_key_here      # Remove the comment to use this
# OPENROUTER_MODEL=openai/gpt-4o-mini                # Remove the comment to use this


# 2. GitHub Search API (OPTIONAL)
# If omitted, it will run anonymously but face extremely strict rate limits.
# GITHUB_TOKEN=your_github_pat_here                 # Remove the comment to use this

# 3. GitLab Search API (OPTIONAL)
# Create one at: https://gitlab.com/-/profile/personal_access_tokens
# GITLAB_TOKEN=your_gitlab_pat_here                # Remove the comment to use this
