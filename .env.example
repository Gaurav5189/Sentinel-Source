# 1. OpenRouter Intelligence (REQUIRED)
# Connects the LLM Evaluation pipeline and Prompt Enhancer.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# 2. GitHub Search API (OPTIONAL)
# If omitted, it will run anonymously but face extremely strict rate limits.
GITHUB_TOKEN=your_github_pat_here

# 3. GitLab Search API (OPTIONAL)
# Entirely separate from GitHub. If omitted, it will run anonymously.
# Create one at: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=your_gitlab_pat_here
